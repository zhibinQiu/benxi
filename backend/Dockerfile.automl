# syntax=docker/dockerfile:1
# 在已有 benxi-api-runtime 上叠加 AutoML（PyCaret），避免重下 Playwright。
#
# PyCaret 3.x 声明 pandas<2.2 / matplotlib<3.8，与平台主依赖冲突，故用 --no-deps
# 安装 pycaret，并单独安装不冲突的传递依赖（沿用镜像内已有 pandas/numpy/matplotlib）。
#
#   docker build -f backend/Dockerfile.automl \
#     --build-arg BASE_IMAGE=benxi-api-runtime:4.8.2 \
#     -t benxi-api-runtime:4.8.2 .

ARG BASE_IMAGE=benxi-api-runtime:latest
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

FROM ${BASE_IMAGE}
ARG PIP_INDEX_URL
WORKDIR /app

RUN pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
      "pycaret==3.3.2" --no-deps && \
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
      "scikit-learn>=1.4.0,<1.5" \
      "joblib>=1.2.0,<1.4" \
      "scipy>=1.11.0,<1.12" \
      "plotly>=5.0.0" \
      "kaleido>=0.2.1" \
      "imbalanced-learn>=0.12.0" \
      "category-encoders>=2.4.0" \
      "lightgbm>=3.0.0" \
      "sktime>=0.26.0,<0.27" \
      "pyod>=1.1.0" \
      "yellowbrick>=1.4" \
      "tbats>=1.1.0" \
      "pmdarima>=2.0.0" \
      "xxhash" \
      "wurlitzer" \
      "deprecation>=2.1.0" \
      "schemdraw>=0.15,<0.16" \
      "ipython>=8.0.0" \
      "ipywidgets>=8.0.0" \
      "tqdm>=4.62.0" \
      "jinja2>=3.0.0" \
      "numba>=0.57.0" \
      "statsmodels>=0.14.0" && \
    python -c "import pycaret; print('automl ok', pycaret.__version__)"
