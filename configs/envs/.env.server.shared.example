# 服务器全栈 + 本机 remote-dev 共用数据
# 见 docs/zh/operations/server-shared.md

BENXI_VERSION=4.9.0
DATA_ROOT=./data
COMPOSE_PROJECT_NAME=benxi
FRONTEND_PORT=40005
STACK_USE_MIRROR=1
STACK_PROFILES="knowflow speech"

# 全栈 + 挂载后端（server-up）；本机 dev 连 TCP 40002–40004、40006，HTTP 依赖走 :40005/deps/…
EXPOSE_DEPS=1
EXPOSE_DEPS_DB_ONLY=1
SERVER_MOUNT_CODE=1

REMOTE_POSTGRES_PORT=40002
REMOTE_REDIS_PORT=40003
REMOTE_MINIO_PORT=40004
REMOTE_MYSQL_PORT=40007
REMOTE_GATEWAY_PORT=40005
REMOTE_GRAPHDB_PORT=40011
REMOTE_NEO4J_PORT=40012
REMOTE_NEO4J_HTTP_PORT=40013

# 知识图谱 / 本体（栈内网地址；GraphDB http://HOST:40011，Neo4j bolt://HOST:40012 / http://HOST:40013）
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=benxi-ontology

POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
REDIS_PASSWORD=infini_rag_flow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

KNOWFLOW_ENABLED=true
DOC_ENGINE=infinity
INFINITY_VERSION=v0.6.0-dev5
MYSQL_PASSWORD=infini_rag_flow
MACOS=0
RAGFLOW_PLATFORM=linux/amd64
RAGFLOW_IMAGE=docker.1ms.run/zxwei/knowflow:v2.1.8
KNOWFLOW_SERVER_IMAGE=docker.1ms.run/zxwei/knowflow-server:v2.1.8

PDF2ZH_IMAGE=registry.cn-hangzhou.aliyuncs.com/docker-qzb/benxi-pdf2zh:3.4.0-amd64
SPEECH_IMAGE=benxi-speech:3.4.0-amd64

FUNASR_DEVICE=cpu
DIARIZATION_ENABLED=true
